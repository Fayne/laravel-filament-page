{
    "name": "fayne/laravel-filament-page",
    "description": "Page management for Filament CMS.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "filament/filament": "^5.0",
        "fayne/laravel-filament-cms-core": "^1.0",
        "fayne/laravel-filament-page-builder": "^1.0"
    },
    "require-dev": {
        "mwguerra/filemanager": "^2.0",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.1",
        "laravel/pint": "^1.27"
    },
    "autoload": {
        "psr-4": {
            "Fayne\\Page\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Fayne\\Page\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "format": "pint --test"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Fayne\\Page\\PageServiceProvider"
            ]
        }
    }
}
